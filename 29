#include <stdbool.h>
#include <string.h>

bool checkInclusion(char* s1, char* s2) {
    int len1 = strlen(s1);
    int len2 = strlen(s2);
    
    if (len1 > len2) return false;
    
    int hashS1[26] = {0};
    int hashWindow[26] = {0};
    
    // Count frequencies for s1 and the first window in s2
    for (int i = 0; i < len1; i++) {
        hashS1[s1[i] - 'a']++;
        hashWindow[s2[i] - 'a']++;
    }
    
    int i = 0;
    int j = len1 - 1;
    
    while (j < len2) {
    
        bool match = true;
        for (int k = 0; k < 26; k++) {
            if (hashS1[k] != hashWindow[k]) {
                match = false;
                break;
            }
        }
        if (match) return true;
        hashWindow[s2[i] - 'a']--;
        i++;
        j++;
        if (j < len2) {
            hashWindow[s2[j] - 'a']++;
        }
    }
    
    return false;
}
