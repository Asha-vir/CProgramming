#include <stdio.h>

int main() {
    int marks[5];
    int sum = 0;
    float average;

    printf("Enter 5 integers:\n");

    // Storing elements into the array
    for(int i = 0; i < 5; ++i) {
        scanf("%d", &marks[i]);
        sum += marks[i]; 
    }

    // Explicit typecasting to float prevents integer truncation
    average = (float)sum / 5;

    printf("Average = %.2f\n", average);
    return 0;
}
